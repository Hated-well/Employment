# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (Gmail SMTP)
# For Gmail, you need to create an App Password:
# 1. Go to Google Account > Security > 2-Step Verification > App Passwords
# 2. Generate a new app password and use it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lucaslucyltd@gmail.com
SMTP_PASS=your_app_password_here

# Recipient Email (where applications are sent)
RECIPIENT_EMAIL=lucaslucyltd@gmail.com

# Website URL (for links in confirmation emails)
WEBSITE_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
